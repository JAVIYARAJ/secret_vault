{
  "manifest_version": 3,
  "name": "Secret Vault Connector",
  "version": "1.0",
  "description": "Companion extension for Secret Vault Desktop",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://localhost:42042/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
